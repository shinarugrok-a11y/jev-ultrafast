TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Beowulf gateway (uv run jev-gateway). Loopback only; callers present the token, never the TypeSafe key.
JEV_GATEWAY_PORT=8767
JEV_GATEWAY_TOKEN=
JEV_DECISION_LOG=artifacts/decisions.jsonl
# Kimi hook receipts (python -m jev_ultrafast.adapters.kimi_acp as a [[hooks]] command).
JEV_RECEIPTS=artifacts/receipts.jsonl
